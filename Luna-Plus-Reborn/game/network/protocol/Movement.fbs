include "Types.fbs";
include "PacketType.fbs";

namespace luna.protocol;

table MoveRequest {
    direction: Vec3;
    target_position: Vec3;
    move_mode: MoveMode;
    kyung_gong_idx: uint16 = 0;  // Dash skill index (0 = none), Old: KyungGongIdx
    added_move_speed: float = 0.0;  // Speed modifier, Old: AddedMoveSpeed
}

table MoveResponse {
    entity_id: uint32;
    position: Vec3;
    velocity: Vec3;
    timestamp: uint64;
}

table EntityMove {
    entity_id: uint32;
    position: Vec3;
    target: Vec3;
    speed: float;
    animation: string;
    timestamp: uint64;
}
