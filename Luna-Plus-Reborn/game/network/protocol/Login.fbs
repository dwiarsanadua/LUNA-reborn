include "Types.fbs";
include "PacketType.fbs";

namespace luna.protocol;

table LoginRequest {
    username: string (required);
    password_hash: [uint8] (required);
    client_version: string;
    file_crc: uint32;
    client_timestamp: uint32;
    mac_address: string;
}

table LoginResponse {
    result: LoginResult;
    session_token: string;
    server_list: [ServerInfo];
}

table ServerListRequest {
    session_token: string;
}

table ServerListResponse {
    servers: [ServerInfo];
}
