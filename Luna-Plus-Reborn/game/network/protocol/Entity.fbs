include "Types.fbs";
include "PacketType.fbs";

namespace luna.protocol;

table EntitySpawn {
    entity_id: uint32;
    entity_type: EntityType;
    model_id: string;
    position: Vec3;
    rotation: float;
    scale: float;
    name: string;
    level: uint16;
    hp_percent: float;
}

table EntityDespawn {
    entity_id: uint32;
    reason: DespawnReason;
}

table EntityTransform {
    entity_id: uint32;
    position: Vec3;
    rotation: float;
    animation: string;
    animation_speed: float;
    timestamp: uint64;
}
